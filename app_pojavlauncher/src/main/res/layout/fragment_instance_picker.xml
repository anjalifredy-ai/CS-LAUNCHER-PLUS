<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1222"
    android:paddingHorizontal="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/instance_picker_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_instance_picker_row"
            android:src="@drawable/ic_arrow_back_white"
            android:contentDescription="@string/global_back"
            android:padding="9dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR INSTANCES"
                android:textColor="#F4F7FF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.04"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select a profile · tap + to create a new one"
                android:textColor="#91A4C4"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26364F" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/instance_picker_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="2dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>
